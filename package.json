{
  "name": "evren-desktop",
  "version": "0.1.1",
  "description": "EVREN LLM API icin Windows masaustu istemcisi",
  "main": "./out/main/index.js",
  "author": "evren-desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "audit:security": "npx -y electron-audit@0.1.11 . --markdown --no-fail",
    "audit:security:legacy": "npx -y @doyensec/electronegativity -i src/main -r -v false",
    "audit:deps": "npm audit --omit=dev",
    "audit:licenses": "npx -y license-checker --summary --production",
    "test:e2e": "node scripts/e2e-smoke.cjs",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.evren.desktop",
    "productName": "EVREN Desktop",
    "copyright": "Copyright © 2026 EVREN Desktop contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "EVREN-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EVREN Desktop",
      "artifactName": "EVREN-Desktop-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mermaid": "^12.2.0",
    "playwright-core": "^1.64.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.22"
  }
}
